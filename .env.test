# Test-only Firebase client config.
#
# Loaded automatically by Vitest (mode=test); NOT loaded by `vite build`,
# which runs in production mode and is gated by vite.config.js.
#
# These are deliberately fake. Five test files import src/firebase/config.js
# for real rather than mocking it, and Firebase's getAuth() rejects an absent
# apiKey outright — so the suite needs a syntactically valid config that
# cannot possibly reach a real project. Before this, those tests were passing
# because the production values were literals in the source.
VITE_FIREBASE_API_KEY=test-api-key-not-real
VITE_FIREBASE_AUTH_DOMAIN=test-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-test-project
VITE_FIREBASE_STORAGE_BUCKET=test-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:testonly
