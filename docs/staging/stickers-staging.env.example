# Isolated staging for manual sticker QA (docs/contact-hub/STICKERS_STAGING_RUNBOOK.md).
# Copy this file OUTSIDE the repository (for example ~/idynify-staging/.env.staging),
# fill in the staging project's values, then check it before every session:
#
#   PRODUCTION_FIREBASE_PROJECT_ID=<production id> node scripts/staging/stagingPreflight.mjs --env=<that file>
#
# Only the variables below. Leave every integration (Gmail, Stripe, Apollo,
# LinkedIn, Barry, email, search) unset: stickers need none of them, and the
# preflight refuses a file that sets one.

# Browser: the staging project's web config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=<staging-id>.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=<staging-id>
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Functions: the same project. Its service account comes from the credential
# (GOOGLE_APPLICATION_CREDENTIALS or STAGING_SERVICE_ACCOUNT_KEY; setup guide A5),
# not from this file. Only without one: FIREBASE_CLIENT_EMAIL and FIREBASE_PRIVATE_KEY here.
FIREBASE_PROJECT_ID=<staging-id>
