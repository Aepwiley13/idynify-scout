// Firestore security rules.
//
// ─── APPEND-ONLY COLLECTIONS ────────────────────────────────────────────────
//   users/{uid}/lineageEvents/{eventId}
//   users/{uid}/icpProfiles/{icpId}/criteriaVersions/{versionId}
//
// These are Sprint 1A's history records. Create is allowed; update and delete
// are not, so "append-only" is enforced by the database rather than by every
// call site remembering. icpRelationshipService also checks existence inside
// its transaction, but that is defence in depth, not the guarantee.
//
// ─── TWO THINGS THAT LOOK CORRECT AND ARE NOT ───────────────────────────────
// Both were caught by running the suite in scripts/rules-check against a real
// emulator. Neither would have failed at deploy time; the first would have
// denied writes for every user.
//
//   1. `document.size()` DOES NOT EXIST for a recursive-wildcard binding.
//      The emulator reports "Function not found error: Name: [size]", and a
//      rule whose expression errors evaluates to DENY — so a size()-based guard
//      does not merely fail to protect, it denies ordinary writes. That is why
//      there is no path introspection anywhere below: `coll` and `sub` are
//      SINGLE-segment wildcards, which bind plain strings and compare directly.
//
//   2. A RECURSIVE WILDCARD MATCHES ZERO OR MORE SEGMENTS, so the deep
//      `/{coll}/{docId}/{rest=**}` block also matches 2-deep documents. Firestore
//      grants access if ANY matching rule allows it, so every guard above has to
//      be repeated there. Omitting one silently re-grants what was withheld.
//
// ─── SERVER-CONTROLLED FIELDS ON users/{uid} ────────────────────────────────
// The owner may write their own user document, but not the fields the server
// trusts for authorization or that record billing. Each is written only by the
// Admin SDK, which bypasses these rules:
//   role                       admin / super_admin access (utils/adminAuth.js,
//                              utils/superAdminAuth.js, verifyAuthToken.js)
//   permissions, permissionsOverride, permissions_reset_at
//                              super-admin permission set (superAdminAuth.js,
//                              superAdminRepairTools.js)
//   accountStatus, suspended*, reactivated*
//                              suspension state (adminSuspendAccount.js,
//                              adminReactivateAccount.js)
//   hasCompletedPayment, paymentCompletedAt, subscriptionTier,
//   subscriptionStatus, selectedTier, status, credits, monthlyCredits,
//   tierLimits, features, billingCycleDate, stripeCustomerId,
//   stripeSubscriptionId       billing (stripe-webhook.js; Signup.jsx at create)
// One client write is allowed: Signup.jsx creates the document with six of the
// billing fields, and only with the values it writes (see signupBilling).
// Deleting the user document is not allowed from a client.
//
// ─── BEFORE CHANGING THIS FILE ──────────────────────────────────────────────
// CI runs the 19-case suite in scripts/rules-check on every PR. Run it locally
// too — it needs a JDK 21+ and takes under a minute. Case 09 is the one that
// matters most: `update users/U/companies/c1 → ALLOW`. The likely failure mode
// of a bad rule is that EVERY product write denies, not that the protected
// collections stay mutable.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function owns(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Fields on users/{uid} that only the server may set (header above).
    function serverControlledUserFields() {
      return ['role', 'permissions', 'permissionsOverride', 'permissions_reset_at',
              'accountStatus', 'suspendedAt', 'suspendedBy', 'suspensionReason',
              'reactivatedAt', 'reactivatedBy', 'reactivationReason',
              'hasCompletedPayment', 'paymentCompletedAt', 'subscriptionTier',
              'subscriptionStatus', 'selectedTier', 'status', 'credits',
              'monthlyCredits', 'tierLimits', 'features', 'billingCycleDate',
              'stripeCustomerId', 'stripeSubscriptionId'];
    }

    // The billing fields Signup.jsx writes when it creates the document.
    function signupBillingFields() {
      return ['selectedTier', 'subscriptionTier', 'status',
              'hasCompletedPayment', 'credits', 'monthlyCredits'];
    }

    // Exactly what Signup.jsx writes: an unpaid account whose credits follow
    // from the tier the user picked (1250 for pro, 400 otherwise).
    function signupBilling(data) {
      return data.keys().hasAll(signupBillingFields())
        && data.status == 'pending_payment'
        && data.hasCompletedPayment == false
        && data.selectedTier is string
        && data.selectedTier.size() <= 40
        && data.subscriptionTier == data.selectedTier
        && data.credits == (data.selectedTier == 'pro' ? 1250 : 400)
        && data.monthlyCredits == data.credits;
    }

    match /users/{userId} {
      allow read: if owns(userId);
      allow create: if owns(userId)
        && !request.resource.data.keys().hasAny(
             serverControlledUserFields().removeAll(signupBillingFields()))
        && (!request.resource.data.keys().hasAny(signupBillingFields())
            || signupBilling(request.resource.data));
      allow update: if owns(userId)
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(serverControlledUserFields());
      allow delete: if false;

      // Every 2-deep document under the user. `coll` is a SINGLE-segment
      // wildcard, so it is a plain string and can be compared directly — no
      // path indexing and no size(), neither of which exists for the recursive
      // wildcard binding.
      match /{coll}/{docId} {
        allow read:   if owns(userId);
        allow create: if owns(userId);
        allow update, delete: if owns(userId) && coll != 'lineageEvents';
      }

      // One level inside an ICP profile: criteriaVersions is append-only,
      // any other subcollection of a profile behaves normally.
      match /icpProfiles/{icpId}/{sub}/{subId} {
        allow read:   if owns(userId);
        allow create: if owns(userId);
        allow update, delete: if owns(userId) && sub != 'criteriaVersions';
      }

      // Anything deeper, outside the subtrees handled above.
      //
      // NOTE: a recursive wildcard matches ZERO OR MORE segments, so this block
      // ALSO matches the 2-deep documents above. Firestore grants access if ANY
      // matching rule allows it, so every guard applied above has to be
      // repeated here — omitting `lineageEvents` here silently re-granted the
      // update the rule above had just withheld.
      match /{coll}/{docId}/{rest=**} {
        allow read:  if owns(userId);
        allow write: if owns(userId)
                     && coll != 'icpProfiles'
                     && coll != 'lineageEvents';
      }
    }

    match /users/{userId}/notifications/{notificationId} {
      allow read, write: if owns(userId);
    }

    match /apiLogs/{logId} {
      allow write: if request.auth != null;
      allow read: if false;
    }

    match /dashboards/{userId} {
      allow read: if owns(userId);
      allow write: if owns(userId);
    }

    match /impersonationSessions/{sessionId} {
      allow read, write: if false;
    }

    // Cooldown state for utils/alertOps.js — when each scheduled job last
    // emailed OPS_ALERT_EMAIL. Written only by the Admin SDK, which bypasses
    // rules entirely, so denying every client is free.
    //
    // Stated explicitly rather than left to Firestore's default-deny. A client
    // that could write here could set lastAlertAtMs into the future and
    // silence every cron alert indefinitely, and the collection would look
    // unprotected to anyone reading this file for what is covered. Default
    // behaviour is not a decision until it is written down.
    match /ops_alerts/{job} {
      allow read, write: if false;
    }
  }
}
