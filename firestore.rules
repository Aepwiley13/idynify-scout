// Firestore security rules.
//
// ─── APPEND-ONLY COLLECTIONS ────────────────────────────────────────────────
//   users/{uid}/lineageEvents/{eventId}
//   users/{uid}/icpProfiles/{icpId}/criteriaVersions/{versionId}
//
// These are Sprint 1A's history records. Create is allowed; update and delete
// are not, so "append-only" is enforced by the database rather than by every
// call site remembering. icpRelationshipService also checks existence inside
// its transaction, but that is defence in depth, not the guarantee.
//
// ─── TWO THINGS THAT LOOK CORRECT AND ARE NOT ───────────────────────────────
// Both were caught by running the suite in scripts/rules-check against a real
// emulator. Neither would have failed at deploy time; the first would have
// denied writes for every user.
//
//   1. `document.size()` DOES NOT EXIST for a recursive-wildcard binding.
//      The emulator reports "Function not found error: Name: [size]", and a
//      rule whose expression errors evaluates to DENY — so a size()-based guard
//      does not merely fail to protect, it denies ordinary writes. That is why
//      there is no path introspection anywhere below: `coll` and `sub` are
//      SINGLE-segment wildcards, which bind plain strings and compare directly.
//
//   2. A RECURSIVE WILDCARD MATCHES ZERO OR MORE SEGMENTS, so the deep
//      `/{coll}/{docId}/{rest=**}` block also matches 2-deep documents. Firestore
//      grants access if ANY matching rule allows it, so every guard above has to
//      be repeated there. Omitting one silently re-grants what was withheld.
//
// ─── SERVER-CONTROLLED FIELDS ON users/{uid} ────────────────────────────────
// The owner may write their own user document, but not the fields the server
// trusts for authorization or that record billing. Each is written only by the
// Admin SDK, which bypasses these rules:
//   role                       admin / super_admin access (utils/adminAuth.js,
//                              utils/superAdminAuth.js, verifyAuthToken.js)
//   permissions, permissionsOverride, permissions_reset_at
//                              super-admin permission set (superAdminAuth.js,
//                              superAdminRepairTools.js)
//   accountStatus, suspended*, reactivated*
//                              suspension state (adminSuspendAccount.js,
//                              adminReactivateAccount.js)
//   hasCompletedPayment, paymentCompletedAt, subscriptionTier,
//   subscriptionStatus, selectedTier, status, credits, monthlyCredits,
//   tierLimits, features, billingCycleDate, stripeCustomerId,
//   stripeSubscriptionId       billing (stripe-webhook.js; Signup.jsx at create)
//   currentPeriodStart, currentPeriodEnd, cancelAtPeriodEnd, pauseCollection,
//   billingDate, nextBillingDate
//                              billing period/cancellation state (billing
//                              hardening PR 1 — stripe-webhook.js). billingDate/
//                              nextBillingDate are legacy field names nothing
//                              writes anymore; protected anyway, closing a gap
//                              where they were the two billing fields NOT on
//                              this list even though the UI reads them.
//   pendingCheckout            checkout claim/recovery state (billing hardening
//                              PR 1 — create-checkout-session.js). One field
//                              holding a nested object; protecting the field
//                              protects everything nested in it (operationId,
//                              status, claimedAt — a client that could write
//                              this could forge a session URL or clear another
//                              request's in-flight claim).
// One client write is allowed: Signup.jsx creates the document with six of the
// billing fields, only on a supported tier and only with the values it writes
// (see signupTiers and signupBilling) — either the legacy numeric `credits`
// shape or the new object shape, both strictly validated and BOTH still
// accepted (not just during a transition window: there is no reliable signal
// from here that every old frontend bundle is gone, so the legacy branch stays
// until there's actual evidence it's safe to remove).
// Deleting the user document is not allowed from a client.
//
// ─── BEFORE CHANGING THIS FILE ──────────────────────────────────────────────
// CI runs the suite in scripts/rules-check on every PR. Run it locally
// too — it needs a JDK 21+ and takes under a minute. Case 09 is the one that
// matters most: `update users/U/companies/c1 → ALLOW`. The likely failure mode
// of a bad rule is that EVERY product write denies, not that the protected
// collections stay mutable.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function owns(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Fields on users/{uid} that only the server may set (header above).
    function serverControlledUserFields() {
      return ['role', 'permissions', 'permissionsOverride', 'permissions_reset_at',
              'accountStatus', 'suspendedAt', 'suspendedBy', 'suspensionReason',
              'reactivatedAt', 'reactivatedBy', 'reactivationReason',
              'hasCompletedPayment', 'paymentCompletedAt', 'subscriptionTier',
              'subscriptionStatus', 'selectedTier', 'status', 'credits',
              'monthlyCredits', 'tierLimits', 'features', 'billingCycleDate',
              'stripeCustomerId', 'stripeSubscriptionId',
              'currentPeriodStart', 'currentPeriodEnd', 'cancelAtPeriodEnd',
              'pauseCollection', 'billingDate', 'nextBillingDate', 'pendingCheckout', 'billingLock'];
    }

    // The billing fields Signup.jsx writes when it creates the document.
    function signupBillingFields() {
      return ['selectedTier', 'subscriptionTier', 'status',
              'hasCompletedPayment', 'credits', 'monthlyCredits'];
    }

    // The tiers a user can sign up for: the two the homepage links to
    // (Homepage.jsx), the two CheckoutPage.jsx has a price and a payment link
    // for, and the two stripe-webhook.js maps a payment to.
    function signupTiers() {
      return ['starter', 'pro'];
    }

    // The two credit allocations a signup is allowed to start with.
    function signupCreditAmount(tier) {
      return tier == 'pro' ? 1250 : 400;
    }

    // Legacy shape: `credits` as a bare number. Unchanged from the original rule.
    function signupBillingLegacyNumber(data) {
      return data.credits == signupCreditAmount(data.selectedTier);
    }

    // New shape: `credits` as an object with known history. Only these four keys,
    // used must be exactly 0 (a fresh signup has used nothing), remaining must equal
    // total, total must be the tier's exact allocation, and resetDate must be null
    // (a pending_payment signup has no billing cycle yet — a client should not be
    // able to set anything else here).
    function signupBillingObjectShape(data) {
      return data.credits.keys().hasOnly(['total', 'used', 'remaining', 'resetDate'])
        && data.credits.used == 0
        && data.credits.total == signupCreditAmount(data.selectedTier)
        && data.credits.remaining == data.credits.total
        && data.credits.resetDate == null;
    }

    // Exactly what Signup.jsx writes: an unpaid account on a supported tier, with the
    // credits that tier starts with — either shape, both strictly validated. Kept
    // dual-accept indefinitely (not for a fixed window): an already-open browser tab
    // running the old bundle can still submit the legacy shape after a deploy, and
    // there's no reliable signal from here that every old tab is gone.
    function signupBilling(data) {
      return data.keys().hasAll(signupBillingFields())
        && data.status == 'pending_payment'
        && data.hasCompletedPayment == false
        && data.selectedTier in signupTiers()
        && data.subscriptionTier == data.selectedTier
        && data.monthlyCredits == signupCreditAmount(data.selectedTier)
        && (signupBillingLegacyNumber(data) || signupBillingObjectShape(data));
    }

    // Integration documents only the server may write (see the users block).
    function serverOwnedIntegration(coll, docId) {
      return coll == 'integrations' && docId == 'linkedin';
    }

    match /users/{userId} {
      allow read: if owns(userId);
      allow create: if owns(userId)
        && !request.resource.data.keys().hasAny(
             serverControlledUserFields().removeAll(signupBillingFields()))
        && (!request.resource.data.keys().hasAny(signupBillingFields())
            || signupBilling(request.resource.data));
      allow update: if owns(userId)
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(serverControlledUserFields());
      allow delete: if false;

      // Every 2-deep document under the user. `coll` is a SINGLE-segment
      // wildcard, so it is a plain string and can be compared directly — no
      // path indexing and no size(), neither of which exists for the recursive
      // wildcard binding.
      //
      // capture_operations is server-only: the capture endpoints read and
      // write it through the Admin SDK, and no client may touch it.
      //
      // integrations/linkedin is read-only to its owner: only the Connect
      // LinkedIn functions write it, after LinkedIn confirms the identity. A
      // client that could write it could mark any LinkedIn member as its own.
      match /{coll}/{docId} {
        allow read:   if owns(userId) && coll != 'capture_operations';
        allow create: if owns(userId) && coll != 'capture_operations'
                      && !serverOwnedIntegration(coll, docId);
        allow update, delete: if owns(userId)
                              && coll != 'lineageEvents'
                              && coll != 'capture_operations'
                              && !serverOwnedIntegration(coll, docId);
      }

      // One level inside an ICP profile: criteriaVersions is append-only,
      // any other subcollection of a profile behaves normally.
      match /icpProfiles/{icpId}/{sub}/{subId} {
        allow read:   if owns(userId);
        allow create: if owns(userId);
        allow update, delete: if owns(userId) && sub != 'criteriaVersions';
      }

      // Anything deeper, outside the subtrees handled above.
      //
      // NOTE: a recursive wildcard matches ZERO OR MORE segments, so this block
      // ALSO matches the 2-deep documents above. Firestore grants access if ANY
      // matching rule allows it, so every guard applied above has to be
      // repeated here — omitting `lineageEvents` here silently re-granted the
      // update the rule above had just withheld.
      match /{coll}/{docId}/{rest=**} {
        allow read:  if owns(userId) && coll != 'capture_operations';
        allow write: if owns(userId)
                     && coll != 'icpProfiles'
                     && coll != 'lineageEvents'
                     && coll != 'capture_operations'
                     && !serverOwnedIntegration(coll, docId);
      }
    }

    match /users/{userId}/notifications/{notificationId} {
      allow read, write: if owns(userId);
    }

    match /apiLogs/{logId} {
      allow write: if request.auth != null;
      allow read: if false;
    }

    match /dashboards/{userId} {
      allow read: if owns(userId);
      allow write: if owns(userId);
    }

    match /impersonationSessions/{sessionId} {
      allow read, write: if false;
    }

    // Cooldown state for utils/alertOps.js — when each scheduled job last
    // emailed OPS_ALERT_EMAIL. Written only by the Admin SDK, which bypasses
    // rules entirely, so denying every client is free.
    //
    // Stated explicitly rather than left to Firestore's default-deny. A client
    // that could write here could set lastAlertAtMs into the future and
    // silence every cron alert indefinitely, and the collection would look
    // unprotected to anyone reading this file for what is covered. Default
    // behaviour is not a decision until it is written down.
    match /ops_alerts/{job} {
      allow read, write: if false;
    }

    // Relationship Capture, server-only like ops_alerts. capture_reports holds
    // opt-in bad-scan reports (card images and values, kept 30 days);
    // capture_enrollment is the beta rollout list, and a client that could
    // write it could enroll itself.
    match /capture_reports/{reportId} {
      allow read, write: if false;
    }
    match /capture_enrollment/{userId} {
      allow read, write: if false;
    }

    // Connect LinkedIn, server-only. oauth_states holds single-use OAuth
    // states (hashed) for ten minutes; a client that could write one could
    // forge a state for another user. linkedin_member_claims records which
    // user holds each LinkedIn account; a client that could write it could
    // take someone else's.
    match /oauth_states/{stateHash} {
      allow read, write: if false;
    }
    match /linkedin_member_claims/{memberHash} {
      allow read, write: if false;
    }

    // Billing hardening PR 1, all server-only like the blocks above.
    //   stripeWebhookEvents          dedup ledger — a client that could write it could fake an
    //                                 event as already applied, or clear one to force a re-apply.
    //   stripeWebhookPendingEvents   parked subscription events whose owning account wasn't yet
    //                                 known at delivery time; drained once it is.
    //   billingAllocations           "has this subscription's initial credit grant already
    //                                 happened" — a client that could write it could grant
    //                                 itself credits, or erase the marker to re-trigger a grant.
    //   billingCheckoutOperations    the durable record created at checkout time (uid, Stripe
    //                                 customer/session/subscription ids, price) that later
    //                                 webhook processing checks an incoming event against before
    //                                 trusting any identity it claims. A client that could write
    //                                 this could manufacture its own "proof" of a purchase.
    //   billingAmbiguousAccounts     append-only audit trail for anything the webhook could not
    //                                 safely auto-resolve.
    match /stripeWebhookEvents/{eventId} {
      allow read, write: if false;
    }
    match /stripeWebhookPendingEvents/{customerId} {
      allow read, write: if false;
    }
    match /stripeWebhookPendingEvents/{customerId}/events/{eventId} {
      allow read, write: if false;
    }
    match /billingAllocations/{subscriptionId} {
      allow read, write: if false;
    }
    match /billingCheckoutOperations/{operationId} {
      allow read, write: if false;
    }
    match /billingAmbiguousAccounts/{docId} {
      allow read, write: if false;
    }
  }
}
