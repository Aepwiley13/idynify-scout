// ════════════════════════════════════════════════════════════════════════════
//  PROPOSED — VERIFIED, NOT YET DEPLOYED.
//
//  firebase.json still points at firestore.rules, which is unchanged. Deploy is
//  a separate, explicitly approved action.
//
//  ✅ VERIFIED against a real Firestore emulator — 19/19 cases pass.
//     Temurin JRE 21 fetched into a scratch dir, firebase-tools emulator run on
//     throwaway project `demo-icp-rules`. No production project, no credentials,
//     no network access to any real data. Reproduce with scripts/rules-check
//     (see its README).
//
//  ─── WHAT VERIFICATION CAUGHT ───────────────────────────────────────────────
//  The first draft of this file was wrong in two ways, and both denied silently
//  rather than erroring at deploy time:
//
//   1. `document.size()` DOES NOT EXIST for a recursive-wildcard binding.
//      The emulator reported "Function not found error: Name: [size]". A rule
//      whose expression errors evaluates to DENY, so the guard did not merely
//      fail to protect the append-only collections — it denied a legitimate
//      update to users/{uid}/icpProfiles/{icpId}, the criteria-version pointer
//      this sprint writes. That is the failure mode worth fearing: total write
//      denial on ordinary paths, not a quiet data issue.
//
//   2. A RECURSIVE WILDCARD MATCHES ZERO OR MORE SEGMENTS.
//      With size() removed, `match /{coll}/{docId}/{rest=**}` still matched the
//      2-deep documents that the narrower rule above had just withheld, and
//      because Firestore grants access if ANY matching rule allows it, the deep
//      rule re-granted the update on lineageEvents. Every guard therefore has
//      to be repeated on the deep rule.
//
//  Both are the kind of thing that reads as correct and behaves as neither.
//
//  ─── THE APPROACH THAT WORKS ────────────────────────────────────────────────
//  No path introspection at all. `coll` and `sub` are SINGLE-segment wildcards,
//  which bind plain strings and compare directly.
//
//  Append-only collections:
//      users/{uid}/lineageEvents/{eventId}
//      users/{uid}/icpProfiles/{icpId}/criteriaVersions/{versionId}
//
//  ─── RESULTS ────────────────────────────────────────────────────────────────
//   01 create lineageEvents              ALLOW ✓   11 update exclusions        ALLOW ✓
//   02 update lineageEvents              DENY  ✓   12 OTHER reads companies    DENY  ✓
//   03 delete lineageEvents              DENY  ✓   13 update 3-deep timeline   ALLOW ✓
//   04 get    lineageEvents              ALLOW ✓   14 update other icp subcoll ALLOW ✓
//   05 create criteriaVersions           ALLOW ✓   15 delete own company       ALLOW ✓
//   06 update criteriaVersions           DENY  ✓   16 update notifications     ALLOW ✓
//   07 update icpProfiles (pointer)      ALLOW ✓   17 update own user doc      ALLOW ✓
//   08 update icpRelationships           ALLOW ✓   18 OTHER creates event      DENY  ✓
//   09 update companies  ← REGRESSION    ALLOW ✓   19 create then update ver.  DENY  ✓
//   10 update contacts                   ALLOW ✓
//
//  Until this is deployed, append-only is enforced by APPLICATION CODE ONLY, in
//  icpRelationshipService.applyEvent. T-21 stays PARTIAL.
// ════════════════════════════════════════════════════════════════════════════

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function owns(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if owns(userId);
      allow write: if owns(userId);

      // Every 2-deep document under the user. `coll` is a SINGLE-segment
      // wildcard, so it is a plain string and can be compared directly — no
      // path indexing and no size(), neither of which exists for the recursive
      // wildcard binding.
      match /{coll}/{docId} {
        allow read:   if owns(userId);
        allow create: if owns(userId);
        allow update, delete: if owns(userId) && coll != 'lineageEvents';
      }

      // One level inside an ICP profile: criteriaVersions is append-only,
      // any other subcollection of a profile behaves normally.
      match /icpProfiles/{icpId}/{sub}/{subId} {
        allow read:   if owns(userId);
        allow create: if owns(userId);
        allow update, delete: if owns(userId) && sub != 'criteriaVersions';
      }

      // Anything deeper, outside the subtrees handled above.
      //
      // NOTE: a recursive wildcard matches ZERO OR MORE segments, so this block
      // ALSO matches the 2-deep documents above. Firestore grants access if ANY
      // matching rule allows it, so every guard applied above has to be
      // repeated here — omitting `lineageEvents` here silently re-granted the
      // update the rule above had just withheld.
      match /{coll}/{docId}/{rest=**} {
        allow read:  if owns(userId);
        allow write: if owns(userId)
                     && coll != 'icpProfiles'
                     && coll != 'lineageEvents';
      }
    }

    match /users/{userId}/notifications/{notificationId} {
      allow read, write: if owns(userId);
    }

    match /apiLogs/{logId} {
      allow write: if request.auth != null;
      allow read: if false;
    }

    match /dashboards/{userId} {
      allow read: if owns(userId);
      allow write: if owns(userId);
    }

    match /impersonationSessions/{sessionId} {
      allow read, write: if false;
    }
  }
}
